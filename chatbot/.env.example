DB_HOST=localhost
DB_PORT=3306
DB_USER=scoula
DB_PASSWORD=
DB_NAME=scoula_db
GEMINI_API_KEY=

# Spring 백엔드(application-secret.properties의 jwt.secret)와 반드시 같은 값을 넣어야 함
# (팀 공용 값은 노션 "환경변수" 페이지 참고). 비워두면 코드 기본값(placeholder)을 쓰는데,
# Spring 쪽에 jwt.secret 오버라이드가 있으면 그 값이랑 안 맞아서 로그인/챗봇 요청이 401로 막힘.
JWT_SECRET=

FSS_API_KEY=
CHEONGYAKHOME_API_KEY=
FUND_API_KEY=
ONTONG_YOUTH_API_KEY=

# LLM 트레이싱/평가(Langfuse, https://langfuse.com) - 팀원 각자 가입해서 발급받은 값을 넣을 것.
# 비워두면 LangGraph 파이프라인에 콜백만 안 붙고 나머지 기능은 그대로 동작함(선택 기능).
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
